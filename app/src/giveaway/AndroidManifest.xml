<?xml version="1.0" encoding="utf-8"?>
<!--
  Giveaway (sideload) builds only. REQUEST_IGNORE_BATTERY_OPTIMIZATIONS turns
  the battery step into a single system dialog instead of dumping the user in
  a list of every app on the phone to hunt for WiM.

  Deliberately NOT in src/main: Google Play reviews this permission case by
  case and it is a documented rejection trigger for overlay apps, so the
  `release` variant keeps the no-permission list intent. PermissionLauncher
  checks at runtime which route it is allowed to take.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      Test-automation receiver, giveaway builds only.

      Speaking into the microphone produces text; everything that can go wrong
      afterwards — disfluency stripping, tone classification, profile-term
      recovery, reconstruction, the meaning guard — is text in, text out. This
      receiver injects raw text straight into that pipeline, so the whole thing
      can be exercised on the real device, against the operator's real profile
      and real settings, without anyone speaking. It is how the 1248-case
      matrix was run, and it was compiled out of every build he actually uses.

      Still absent from `release`: it is exported, so anything on the phone can
      drive it. Fine on the operator's own sideload build; not something to
      hand to strangers through Play.
    -->
    <application>
        <receiver
            android:name=".WimTestReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="${applicationId}.TEST" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
