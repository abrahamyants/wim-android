<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Mic access for recording -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Overlay for floating bubble -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Network for Whisper + reconstruction API -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Haptic feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Notifications (required Android 13+, keeps foreground service alive) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Bluetooth mic routing for wireless headsets -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Foreground service for persistent bubble -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Prevent battery optimizer from killing the service -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Restart bubble after device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".WimApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="What I Meant"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WhatIMeant">

        <!-- Bouncer (first run) — permission gate -->
        <!-- Legacy .OnboardingActivity removed 2026-05-16: never launched, dead code. -->

        <activity
            android:name=".BouncerActivity"
            android:exported="false"
            android:theme="@style/Theme.WhatIMeant" />

        <!--
            Compose-based onboarding rewrite (option 3, 2026-05-16). Parallel route
            not yet wired into MainActivity.kt:95 first-run routing. Manually launch
            for testing:  adb shell am start -n com.wim.app/.onboarding.OnboardingActivity
            Once the screens reach feature parity, flip MainActivity routing and
            delete BouncerActivity + activity_bouncer.xml + onboarding.html.
        -->
        <activity
            android:name=".onboarding.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.WhatIMeant" />

        <!-- Manual: WebView host for the illustrated user guide at
             assets/user_guide.html. Launched from MainActivity's Guide
             section via the "READ THE FULL MANUAL" launcher card. -->
        <activity
            android:name=".GuideActivity"
            android:exported="false"
            android:theme="@style/Theme.WhatIMeant" />

        <!-- Main activity: settings -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Floating bubble service -->
        <service
            android:name=".BubbleService"
            android:foregroundServiceType="specialUse|microphone"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent floating overlay for voice-to-text dictation that must remain active while the user speaks into other apps" />
        </service>

        <!-- Quick Settings tile: tap to summon the floating bubble.
             Tap-to-record from the QS shade was confusing — the bubble
             itself is the recording affordance. The tile now just makes
             sure the bubble is visible. -->
        <service
            android:name=".WimTileService"
            android:label="WiM"
            android:icon="@drawable/ic_qs_tile_wm"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Home screen widget: 1x1 tap-to-record -->
        <receiver
            android:name=".WimWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- Boot receiver: restart bubble after device reboot -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- WimTestReceiver is declared in app/src/debug/AndroidManifest.xml — debug builds only -->

        <!-- Accessibility service for text field detection + injection -->
        <service
            android:name=".WimAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

    </application>
</manifest>
