  "preferred_terms": [
    {
      "loose": "code",
      "precise": "codebase",
      "when": "the speaker means the whole body of source in a project, not the act of writing or one snippet"
    },
    {
      "loose": "repo",
      "precise": "repository",
      "when": "the tone is formal; leave 'repo' alone in professional and casual tone, it is normal speech among engineers"
    },
    {
      "loose": "fix",
      "precise": "patch",
      "when": "the speaker means a specific shipped change, not the act of fixing"
    },
    {
      "loose": "crash",
      "precise": "exception",
      "when": "the speaker is describing a caught error in code rather than the app dying"
    },
    {
      "loose": "slow",
      "precise": "high latency",
      "when": "the speaker is describing a measured request or response time"
    },
    {
      "loose": "broke",
      "precise": "regressed",
      "when": "the speaker means something that used to work and now does not"
    },
    {
      "loose": "put it live",
      "precise": "deploy",
      "when": "the speaker means releasing a build to an environment"
    },
    {
      "loose": "test it",
      "precise": "run the test suite",
      "when": "the speaker means the automated tests, not manual checking"
    },
    {
      "loose": "the server",
      "precise": "the backend",
      "when": "the speaker means our own service rather than a specific machine"
    },
    {
      "loose": "library",
      "precise": "dependency",
      "when": "the speaker means something the project pulls in, not a general body of code"
    }
  ]
