<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1A1A1E" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#06FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#04FFFFFF"
                android:angle="0" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#03FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#05FFFFFF"
                android:angle="180" />
        </shape>
    </item>
</layer-list>
