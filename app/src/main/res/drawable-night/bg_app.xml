<?xml version="1.0" encoding="utf-8"?>
<!-- Dark mode: deep dark background with subtle grain texture -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base: solid dark -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1A1A1E" />
        </shape>
    </item>
    <!-- Subtle vertical depth gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#00000000"
                android:centerColor="#06000000"
                android:endColor="#10000000"
                android:angle="270" />
        </shape>
    </item>
</layer-list>
