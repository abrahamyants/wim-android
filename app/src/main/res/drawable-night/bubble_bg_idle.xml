<?xml version="1.0" encoding="utf-8"?>
<!-- Night mode: bubble idle — warm bronze on dark bg, approved palette only -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer ring — warm copper on dark -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="32dp"
                android:centerX="0.42"
                android:centerY="0.38"
                android:startColor="#FFC49A6C"
                android:endColor="#FF8A5A2F" />
            <stroke android:width="2dp" android:color="#FFB55050" />
            <size android:width="60dp" android:height="60dp" />
        </shape>
    </item>
    <!-- Inner circle — dark surface with copper hue -->
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="26dp"
                android:centerX="0.45"
                android:centerY="0.40"
                android:startColor="#FF333338"
                android:endColor="#FF1A1A1E" />
            <size android:width="50dp" android:height="50dp" />
        </shape>
    </item>
    <!-- Top highlight shimmer — cream -->
    <item android:left="10dp" android:top="2dp" android:right="10dp" android:bottom="36dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#40C8B48A"
                android:endColor="#00C8B48A" />
            <size android:width="40dp" android:height="22dp" />
        </shape>
    </item>
</layer-list>
