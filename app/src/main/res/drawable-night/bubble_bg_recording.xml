<?xml version="1.0" encoding="utf-8"?>
<!-- Night mode: recording state, red accent — dark inner fill -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer ring — dark raised surface with red glow stroke -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="32dp"
                android:centerX="0.42"
                android:centerY="0.38"
                android:startColor="#FF333338"
                android:endColor="#FF222226" />
            <stroke android:width="3dp" android:color="#FFEF4444" />
            <size android:width="60dp" android:height="60dp" />
        </shape>
    </item>
    <!-- Inner circle — dark maroon tint -->
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="26dp"
                android:centerX="0.45"
                android:centerY="0.40"
                android:startColor="#FF3A2020"
                android:endColor="#FF1A1A1E" />
            <size android:width="50dp" android:height="50dp" />
        </shape>
    </item>
    <!-- Top highlight shimmer -->
    <item android:left="10dp" android:top="2dp" android:right="10dp" android:bottom="36dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#28FFFFFF"
                android:endColor="#00FFFFFF" />
            <size android:width="40dp" android:height="22dp" />
        </shape>
    </item>
</layer-list>
