<?xml version="1.0" encoding="utf-8"?>
<!-- Night mode: inner sunken well — dark surface, visible inset -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow ring (inset effect) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FF222226" />
            <stroke android:width="1dp" android:color="#33000000" />
            <size android:width="44dp" android:height="44dp" />
        </shape>
    </item>
    <!-- Inner surface — dark sunken -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#FF18181C" />
            <size android:width="40dp" android:height="40dp" />
        </shape>
    </item>
</layer-list>
