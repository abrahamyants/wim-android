<?xml version="1.0" encoding="utf-8"?>
<!-- Night mode: raised knob face — copper on dark bg -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow well — dark base -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FF1A1A1E" />
            <size android:width="44dp" android:height="44dp" />
        </shape>
    </item>
    <!-- Knob side wall — copper rim -->
    <item android:left="1dp" android:top="0dp" android:right="1dp" android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#FFC49A6C"
                android:endColor="#FF8A5A2F" />
            <stroke android:width="0.5dp" android:color="#44000000" />
            <size android:width="42dp" android:height="42dp" />
        </shape>
    </item>
    <!-- Knob top face — matte copper -->
    <item android:left="3dp" android:top="2dp" android:right="3dp" android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#FFC8B48A"
                android:endColor="#FFC49A6C" />
            <size android:width="38dp" android:height="38dp" />
        </shape>
    </item>
    <!-- Bottom shadow on face -->
    <item android:left="5dp" android:top="28dp" android:right="5dp" android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#30000000"
                android:endColor="#00000000" />
            <size android:width="34dp" android:height="12dp" />
        </shape>
    </item>
</layer-list>
