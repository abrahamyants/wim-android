<?xml version="1.0" encoding="utf-8"?>
<!-- Dark mode: raised card on dark surface -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom shadow -->
    <item android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#60000000" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Main body: dark gradient -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF333338"
                android:centerColor="#FF2A2A2F"
                android:endColor="#FF262630"
                android:angle="270" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Inner highlight (subtle top edge gleam) -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#08FFFFFF" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</layer-list>
