<?xml version="1.0" encoding="utf-8"?>
<!-- Night mode — input row variant: matches the selected-chip palette in
     User Profile (dark maroon card + orange left accent bar) so the
     "add" rows speak the same visual language as the chips above them. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF3a2a2f"
                android:centerColor="#FF332228"
                android:endColor="#FF2a1e22"
                android:angle="270" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#40EE5A24" />
        </shape>
    </item>
    <item android:width="3dp" android:top="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFEE5A24" />
            <corners android:topRightRadius="2dp" android:bottomRightRadius="2dp" />
        </shape>
    </item>
</layer-list>
