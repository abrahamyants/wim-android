<?xml version="1.0" encoding="utf-8"?>
<!-- Night mode: gold theme indicator — dark inner, gold outer stays -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <!-- Outer glow ring — cream when active -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#FFC8B48A" />
                    <size android:width="34dp" android:height="34dp" />
                </shape>
            </item>
            <!-- Gold bezel inset 2dp — same both modes (gold is gold) -->
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="18dp"
                        android:centerX="0.42"
                        android:centerY="0.38"
                        android:startColor="#FFF0E8D8"
                        android:endColor="#FFC49A6C" />
                    <stroke android:width="1dp" android:color="#FFB55050" />
                </shape>
            </item>
            <!-- Inner well — dark surface -->
            <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="14dp"
                        android:centerX="0.45"
                        android:centerY="0.40"
                        android:startColor="#FF333338"
                        android:endColor="#FF1A1A1E" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="18dp"
                        android:centerX="0.42"
                        android:centerY="0.38"
                        android:startColor="#FFF0E8D8"
                        android:endColor="#FFC49A6C" />
                    <stroke android:width="1dp" android:color="#FFB55050" />
                    <size android:width="34dp" android:height="34dp" />
                </shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="14dp"
                        android:centerX="0.45"
                        android:centerY="0.40"
                        android:startColor="#FF333338"
                        android:endColor="#FF1A1A1E" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
