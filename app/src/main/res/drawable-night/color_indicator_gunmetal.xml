<?xml version="1.0" encoding="utf-8"?>
<!-- Night mode: gunmetal theme indicator — dark steel is already on-brand for dark mode -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <!-- Outer glow ring — copper highlight when active -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#FFC49A6C" />
                    <size android:width="34dp" android:height="34dp" />
                </shape>
            </item>
            <!-- Gunmetal bezel — uses dark approved tones -->
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="18dp"
                        android:centerX="0.42"
                        android:centerY="0.38"
                        android:startColor="#FF8A8078"
                        android:endColor="#FF222226" />
                    <stroke android:width="1dp" android:color="#FFB55050" />
                </shape>
            </item>
            <!-- Inner well — deeper dark -->
            <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="14dp"
                        android:centerX="0.45"
                        android:centerY="0.40"
                        android:startColor="#FF2A2A2F"
                        android:endColor="#FF18181C" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="18dp"
                        android:centerX="0.42"
                        android:centerY="0.38"
                        android:startColor="#FF8A8078"
                        android:endColor="#FF222226" />
                    <stroke android:width="1dp" android:color="#FFB55050" />
                    <size android:width="34dp" android:height="34dp" />
                </shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="14dp"
                        android:centerX="0.45"
                        android:centerY="0.40"
                        android:startColor="#FF2A2A2F"
                        android:endColor="#FF18181C" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
