<?xml version="1.0" encoding="utf-8"?>
<!-- Night mode: fader thumb — dark raised surface with copper gradient -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Square knob body — dark with copper -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF333338"
                android:centerColor="#FF2A2A2F"
                android:endColor="#FF222226"
                android:angle="270" />
            <corners android:radius="3dp" />
            <stroke android:width="0.7dp" android:color="#FF1A1A1E" />
            <size android:width="20dp" android:height="20dp" />
        </shape>
    </item>
    <!-- Center indicator line -->
    <item android:top="9dp" android:bottom="9dp" android:left="3dp" android:right="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFB55050" />
        </shape>
    </item>
    <!-- Top highlight strip -->
    <item android:top="2dp" android:bottom="15dp" android:left="3dp" android:right="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#66FFFFFF" />
        </shape>
    </item>
</layer-list>
