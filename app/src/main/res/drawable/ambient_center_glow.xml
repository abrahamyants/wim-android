<?xml version="1.0" encoding="utf-8"?>
<!-- Subtle radial gold glow for center ambient pulse -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="150dp"
        android:startColor="#4DFFFFFF"
        android:centerColor="#1DA0724A"
        android:endColor="#00000000" />
    <size android:width="300dp" android:height="300dp" />
</shape>
