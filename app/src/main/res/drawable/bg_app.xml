<?xml version="1.0" encoding="utf-8"?>
<!-- Premium dark background — Лаврентий-style woven texture -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF111120" />
        </shape>
    </item>
    <!-- Fabric grain — vertical threads -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0AFFFFFF"
                android:centerColor="#02FFFFFF"
                android:endColor="#08FFFFFF"
                android:angle="90" />
        </shape>
    </item>
    <!-- Fabric grain — horizontal threads -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#08FFFFFF"
                android:centerColor="#02FFFFFF"
                android:endColor="#0AFFFFFF"
                android:angle="0" />
        </shape>
    </item>
    <!-- Crosshatch 1 — 45deg -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0CFFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#06FFFFFF"
                android:angle="45" />
        </shape>
    </item>
    <!-- Crosshatch 2 — 315deg -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#06FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#0CFFFFFF"
                android:angle="315" />
        </shape>
    </item>
    <!-- Crosshatch 3 — 135deg (second pass, tighter) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#08FFFFFF"
                android:centerColor="#01FFFFFF"
                android:endColor="#04FFFFFF"
                android:angle="135" />
        </shape>
    </item>
    <!-- Warm center glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="450dp"
                android:centerX="0.5"
                android:centerY="0.35"
                android:startColor="#0CEE5A24"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Vignette -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="550dp"
                android:centerX="0.5"
                android:centerY="0.35"
                android:startColor="#00000000"
                android:endColor="#50000000" />
        </shape>
    </item>
</layer-list>
