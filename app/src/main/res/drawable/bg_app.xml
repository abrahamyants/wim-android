<?xml version="1.0" encoding="utf-8"?>
<!-- Лаврентий light mode — brushed aluminum chassis -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFE0E0E4"
                android:endColor="#FFB0B0B8"
                android:angle="270" />
        </shape>
    </item>
    <!-- Horizontal brushed grain -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#06000000"
                android:centerColor="#00000000"
                android:endColor="#04000000"
                android:angle="0" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#03000000"
                android:centerColor="#00000000"
                android:endColor="#05000000"
                android:angle="180" />
        </shape>
    </item>
</layer-list>
