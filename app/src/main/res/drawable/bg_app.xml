<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 1 premium dark background with subtle depth -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1A1A2E" />
        </shape>
    </item>
    <!-- Subtle radial glow from top center -->
    <item android:top="-100dp" android:left="-50dp" android:right="-50dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="400dp"
                android:startColor="#0AEE5A24"
                android:endColor="#00000000" />
            <size android:width="500dp" android:height="400dp" />
        </shape>
    </item>
</layer-list>
