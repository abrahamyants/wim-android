<?xml version="1.0" encoding="utf-8"?>
<!-- Premium dark background with visible fabric/brushed texture -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base dark -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF121220" />
        </shape>
    </item>
    <!-- Visible diagonal grain — direction 1 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#10FFFFFF"
                android:centerColor="#02FFFFFF"
                android:endColor="#08FFFFFF"
                android:angle="135" />
        </shape>
    </item>
    <!-- Visible diagonal grain — direction 2, cross -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#08FFFFFF"
                android:centerColor="#02FFFFFF"
                android:endColor="#10FFFFFF"
                android:angle="225" />
        </shape>
    </item>
    <!-- Warm radial glow from center — ambient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="500dp"
                android:centerX="0.5"
                android:centerY="0.35"
                android:startColor="#0CEE5A24"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Vignette — darker edges -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="600dp"
                android:centerX="0.5"
                android:centerY="0.3"
                android:startColor="#00000000"
                android:endColor="#50000000" />
        </shape>
    </item>
</layer-list>
