<?xml version="1.0" encoding="utf-8"?>
<!-- Light mode — warm tan base, like leather desk -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFD4C8B0" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0A000000"
                android:centerColor="#00000000"
                android:endColor="#08000000"
                android:angle="0" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#06000000"
                android:centerColor="#00000000"
                android:endColor="#0A000000"
                android:angle="180" />
        </shape>
    </item>
</layer-list>
