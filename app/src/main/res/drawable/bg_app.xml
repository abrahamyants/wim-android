<?xml version="1.0" encoding="utf-8"?>
<!-- Premium dark background with Лаврентий-style subtle fabric texture -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base dark -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF141420" />
        </shape>
    </item>
    <!-- Subtle vertical grain — fabric/brushed texture feel -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#04FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#03FFFFFF"
                android:angle="90" />
        </shape>
    </item>
    <!-- Diagonal crosshatch overlay -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#03FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#02FFFFFF"
                android:angle="135" />
        </shape>
    </item>
    <!-- Second crosshatch pass — opposite angle -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#02FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#03FFFFFF"
                android:angle="225" />
        </shape>
    </item>
    <!-- Warm radial glow from top center — pulsating orb area -->
    <item android:top="-100dp" android:left="-50dp" android:right="-50dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="400dp"
                android:startColor="#0CEE5A24"
                android:endColor="#00000000" />
            <size android:width="500dp" android:height="400dp" />
        </shape>
    </item>
    <!-- Subtle vignette — darker edges -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="600dp"
                android:centerX="0.5"
                android:centerY="0.3"
                android:startColor="#00000000"
                android:endColor="#40000000" />
        </shape>
    </item>
</layer-list>
