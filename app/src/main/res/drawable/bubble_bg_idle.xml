<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer ring — dark aluminum bezel -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FF6A6A70" />
            <stroke android:width="2dp" android:color="#FFEE5A24" />
            <size android:width="60dp" android:height="60dp" />
        </shape>
    </item>
    <!-- Inner circle — lighter centre for contrast -->
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="oval">
            <solid android:color="#FF8A8A90" />
            <size android:width="48dp" android:height="48dp" />
        </shape>
    </item>
</layer-list>
