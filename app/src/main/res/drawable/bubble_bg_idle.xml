<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer ring — brushed aluminum -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFC8C8CC" />
            <stroke android:width="2dp" android:color="#FFEE5A24" />
            <size android:width="60dp" android:height="60dp" />
        </shape>
    </item>
    <!-- Inner circle — slightly darker centre -->
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="oval">
            <solid android:color="#FFB8B8BC" />
            <size android:width="48dp" android:height="48dp" />
        </shape>
    </item>
</layer-list>
