<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer ring — aluminum with red glow stroke -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FF6A6A70" />
            <stroke android:width="3dp" android:color="#FFEF4444" />
            <size android:width="60dp" android:height="60dp" />
        </shape>
    </item>
    <!-- Inner circle — warm tint on darker base -->
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="oval">
            <solid android:color="#FF9A8080" />
            <size android:width="48dp" android:height="48dp" />
        </shape>
    </item>
</layer-list>
