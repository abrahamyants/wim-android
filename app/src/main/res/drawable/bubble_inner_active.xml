<?xml version="1.0" encoding="utf-8"?>
<!-- Inner well when recording — glowing RED ember: the knob heated red-hot to
     match the red "REC" label. NOT a flat red sticker — the 2026-06-08 objection
     was the flat, blinking disk, not red itself. The radial glow + the
     BubbleAffect lean-and-breathe carry "recording", no blink needed.
     All colors are approved brand tokens (the red family). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/red_primary" />
            <stroke android:width="1dp" android:color="@color/border_subtle" />
            <size android:width="44dp" android:height="44dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="22dp"
                android:startColor="@color/red_hot"
                android:centerColor="@color/red_bright"
                android:endColor="@color/red_primary" />
            <size android:width="40dp" android:height="40dp" />
        </shape>
    </item>
</layer-list>
