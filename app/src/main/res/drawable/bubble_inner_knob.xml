<?xml version="1.0" encoding="utf-8"?>
<!-- Inner knob with 3D depth — concave centre with highlight arc -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer shadow ring (inset effect, deeper than before) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFA5A5AA" />
            <stroke android:width="1dp" android:color="#44000000" />
            <size android:width="44dp" android:height="44dp" />
        </shape>
    </item>
    <!-- Mid ring — transition depth -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="22dp"
                android:startColor="#FFB0B0B5"
                android:endColor="#FFA8A8AD" />
            <size android:width="42dp" android:height="42dp" />
        </shape>
    </item>
    <!-- Inner surface — radial gradient for concave depth -->
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="20dp"
                android:centerX="0.42"
                android:centerY="0.38"
                android:startColor="#FFC4C4C8"
                android:endColor="#FFADADB2" />
            <size android:width="38dp" android:height="38dp" />
        </shape>
    </item>
    <!-- Top highlight arc — light catching the upper edge -->
    <item android:left="6dp" android:top="3dp" android:right="6dp" android:bottom="20dp">
        <shape android:shape="oval">
            <solid android:color="#0DFFFFFF" />
            <size android:width="32dp" android:height="18dp" />
        </shape>
    </item>
</layer-list>
