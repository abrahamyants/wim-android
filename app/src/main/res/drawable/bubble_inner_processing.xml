<?xml version="1.0" encoding="utf-8"?>
<!-- Inner well during processing — warm AMBER ember (post-recording, pre-result)
     to match the amber "PROC" label. This is the bronze-knob-heated-up ember that
     used to be the recording color (pre-2026-06-25); it now reads as the middle
     beat: RED "REC" -> AMBER "PROC" -> GREEN "SEND".
     All colors are approved brand tokens (was raw-hex green; tokenized to the
     amber family on 2026-06-25). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/orange_label" />
            <stroke android:width="1dp" android:color="@color/border_subtle" />
            <size android:width="44dp" android:height="44dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="22dp"
                android:startColor="@color/yellow_gold"
                android:centerColor="@color/orange_amber"
                android:endColor="@color/copper_gold" />
            <size android:width="40dp" android:height="40dp" />
        </shape>
    </item>
</layer-list>
