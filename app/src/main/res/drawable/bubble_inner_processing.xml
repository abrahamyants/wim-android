<?xml version="1.0" encoding="utf-8"?>
<!-- Inner well during processing — plain AMBER (egg-yolk yellow), built exactly like the RED
     well before it and the GREEN well after it: a deep solid disc under a
     bright-to-deep radial gradient. The disc and the gradient's edge are the
     same color, so no second ring shows around the face (2026-09-06; the old
     burnt-orange disc under a yellow-amber gradient drew a visible rim).
     RED "REC" -> ORANGE "PROC" -> GREEN "SEND". -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/orange_deep" />
            <stroke android:width="1dp" android:color="@color/border_subtle" />
            <size android:width="44dp" android:height="44dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="22dp"
                android:startColor="@color/orange_hot"
                android:centerColor="@color/orange_bright"
                android:endColor="@color/orange_deep" />
            <size android:width="40dp" android:height="40dp" />
        </shape>
    </item>
</layer-list>
