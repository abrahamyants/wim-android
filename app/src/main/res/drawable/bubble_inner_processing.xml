<?xml version="1.0" encoding="utf-8"?>
<!-- Inner well during processing — green glow (post-recording, pre-result) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FF40A065" />
            <stroke android:width="1dp" android:color="#44000000" />
            <size android:width="44dp" android:height="44dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="22dp"
                android:startColor="#FF50C078"
                android:centerColor="#FF40A065"
                android:endColor="#FF308050" />
            <size android:width="40dp" android:height="40dp" />
        </shape>
    </item>
</layer-list>
