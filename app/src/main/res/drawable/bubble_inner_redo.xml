<?xml version="1.0" encoding="utf-8"?>
<!-- Inner well while tap-to-redo is armed — glowing INDIGO. Sibling of
     bubble_inner_send.xml; only the colour family differs, so the two states
     read as the same mechanism wearing a different coat. Text reads REDO, so
     colour reinforces the state without carrying meaning by itself. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/indigo_deep" />
            <stroke android:width="1dp" android:color="@color/border_subtle" />
            <size android:width="44dp" android:height="44dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="22dp"
                android:startColor="@color/indigo_bright"
                android:centerColor="@color/indigo_active"
                android:endColor="@color/indigo_deep" />
            <size android:width="40dp" android:height="40dp" />
        </shape>
    </item>
</layer-list>
