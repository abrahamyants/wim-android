<?xml version="1.0" encoding="utf-8"?>
<!-- Normal tone-btn: 3D raised button on brushed aluminum -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom shadow layer (2px darker border for depth) -->
    <item android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#40000000" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Main raised button body: gradient #B5B5BA → #BFBFC4 → #B8B8BD -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFB5B5BA"
                android:centerColor="#FFBFBFC4"
                android:endColor="#FFB8B8BD"
                android:angle="270" />
            <stroke android:width="1dp" android:color="#1F000000" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Inner highlight line (top edge gleam) -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</layer-list>
