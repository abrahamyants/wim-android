<?xml version="1.0" encoding="utf-8"?>
<!-- Light mode — input row variant: matches the selected-chip palette in
     User Profile (maroon-tinted card + orange left accent bar) so the
     "add" rows are visually consistent with the chip language above. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFd8c0c0"
                android:centerColor="#FFe0c8c8"
                android:endColor="#FFe8d0d0"
                android:angle="270" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#40EE5A24" />
        </shape>
    </item>
    <item android:width="3dp" android:top="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFEE5A24" />
            <corners android:topRightRadius="2dp" android:bottomRightRadius="2dp" />
        </shape>
    </item>
</layer-list>
