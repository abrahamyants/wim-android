<?xml version="1.0" encoding="utf-8"?>
<!-- Лаврентий dark — pressable raised card -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF3a3a40"
                android:centerColor="#FF333338"
                android:endColor="#FF2e2e34"
                android:angle="270" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#24FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF333338"
                android:centerColor="#FF2a2a2f"
                android:endColor="#FF24242a"
                android:angle="270" />
            <corners android:radius="6dp" />
            <stroke android:width="0.5dp" android:color="#14FFFFFF" />
        </shape>
    </item>
</selector>
