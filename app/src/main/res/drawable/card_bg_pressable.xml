<?xml version="1.0" encoding="utf-8"?>
<!-- Pressable dark glass card — matches card_bg base -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2E2E3A" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#20D4A574" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF222230" />
            <corners android:radius="6dp" />
            <stroke android:width="0.5dp" android:color="#12FFFFFF" />
        </shape>
    </item>
</selector>
