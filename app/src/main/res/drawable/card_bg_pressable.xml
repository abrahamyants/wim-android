<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFEDE4D0"
                android:centerColor="#FFE6DCC8"
                android:endColor="#FFDFD4BC"
                android:angle="270" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#30000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFF8F2E4"
                android:centerColor="#FFF2EBDA"
                android:endColor="#FFEDE4D0"
                android:angle="270" />
            <corners android:radius="6dp" />
            <stroke android:width="0.5dp" android:color="#20000000" />
        </shape>
    </item>
</selector>
