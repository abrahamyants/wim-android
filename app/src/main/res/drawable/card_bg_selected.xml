<?xml version="1.0" encoding="utf-8"?>
<!-- Active tone-btn: dark red pressed-in with LED strip + gold dot -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark red pressed-in body: gradient #8A1A1A → #7A1515 → #6A1212 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF8A1A1A"
                android:centerColor="#FF7A1515"
                android:endColor="#FF6A1212"
                android:angle="270" />
            <stroke android:width="1dp" android:color="#66000000" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Inset shadow overlay (pressed look) — darker top edge -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#59000000" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <!-- Left-edge LED strip: 3px red glowing bar -->
    <item android:width="3dp" android:top="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFFF8A8A"
                android:centerColor="#FFFF5555"
                android:endColor="#FFFF8A8A"
                android:angle="270" />
            <corners
                android:topLeftRadius="0dp"
                android:bottomLeftRadius="0dp"
                android:topRightRadius="2dp"
                android:bottomRightRadius="2dp" />
        </shape>
    </item>
    <!-- Gold LED dot on the right side -->
    <item
        android:width="6dp"
        android:height="6dp"
        android:gravity="end|center_vertical"
        android:right="8dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#FFFFE0A0"
                android:centerColor="#FFD4A574"
                android:endColor="#FFB8855A"
                android:type="radial"
                android:gradientRadius="3dp" />
        </shape>
    </item>
</layer-list>
