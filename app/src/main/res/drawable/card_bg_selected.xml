<?xml version="1.0" encoding="utf-8"?>
<!-- Selected card — copper gold border on same base -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF2A2234" />
            <corners android:radius="6dp" />
            <stroke android:width="1.5dp" android:color="#66D4A574" />
        </shape>
    </item>
    <!-- Left accent bar -->
    <item android:width="3dp" android:top="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFEE5A24" />
            <corners android:topRightRadius="2dp" android:bottomRightRadius="2dp" />
        </shape>
    </item>
</layer-list>
