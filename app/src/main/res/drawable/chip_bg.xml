<?xml version="1.0" encoding="utf-8"?>
<!-- Status chip — thin pill, maroon border, near-transparent fill -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2A5C2828" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#FF8A3030" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#FF5C2828" />
        </shape>
    </item>
</selector>
