<?xml version="1.0" encoding="utf-8"?>
<!-- Color picker pill — gold (formerly Gunmetal). Theme keeps "gunmetal" key
     for backwards compat with prefs; UI label and accent are gold. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFF6D87C"
                android:centerColor="#FFD4AF37"
                android:endColor="#FF8B6914"
                android:angle="135" />
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="#FF1A1A20" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFF6D87C"
                android:centerColor="#FFD4AF37"
                android:endColor="#FF8B6914"
                android:angle="135" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#FFB55050" />
        </shape>
    </item>
</selector>
