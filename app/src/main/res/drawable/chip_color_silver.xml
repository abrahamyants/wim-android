<?xml version="1.0" encoding="utf-8"?>
<!-- Color picker pill — silver with metallic shine via gradient -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFE8E8EC"
                android:centerColor="#FFB8B8C0"
                android:endColor="#FF888890"
                android:angle="135" />
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="#FF1A1A20" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFE8E8EC"
                android:centerColor="#FFB8B8C0"
                android:endColor="#FF888890"
                android:angle="135" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#FFB55050" />
        </shape>
    </item>
</selector>
