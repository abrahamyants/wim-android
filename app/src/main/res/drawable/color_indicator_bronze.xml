<?xml version="1.0" encoding="utf-8"?>
<!-- Tiny replica of the gold-face ("bronze") bubble: copper ring, the dark
     well, gold face. 2026-09-04: the well was missing, so the marker read
     as a flat gold coin while the bubble it picks has a black ring around
     its face. state_selected = cream glow ring outside. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#FFF0E8D8" />
                    <size android:width="34dp" android:height="34dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="18dp"
                        android:centerX="0.42"
                        android:centerY="0.38"
                        android:startColor="#FFE6D4B0"
                        android:endColor="#FF9A7C54" />
                    <stroke android:width="1dp" android:color="#FFB55050" />
                </shape>
            </item>
            <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="14dp"
                        android:centerX="0.45"
                        android:centerY="0.40"
                        android:startColor="#FF333338"
                        android:endColor="#FF1A1A1E" />
                </shape>
            </item>
            <item android:left="9dp" android:top="9dp" android:right="9dp" android:bottom="9dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="10dp"
                        android:centerX="0.45"
                        android:centerY="0.40"
                        android:startColor="#FFCCAD83"
                        android:endColor="#FF7A5C3C" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="18dp"
                        android:centerX="0.42"
                        android:centerY="0.38"
                        android:startColor="#FFE6D4B0"
                        android:endColor="#FF9A7C54" />
                    <stroke android:width="1dp" android:color="#FFB55050" />
                    <size android:width="34dp" android:height="34dp" />
                </shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="14dp"
                        android:centerX="0.45"
                        android:centerY="0.40"
                        android:startColor="#FF333338"
                        android:endColor="#FF1A1A1E" />
                </shape>
            </item>
            <item android:left="7dp" android:top="7dp" android:right="7dp" android:bottom="7dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="10dp"
                        android:centerX="0.45"
                        android:centerY="0.40"
                        android:startColor="#FFCCAD83"
                        android:endColor="#FF7A5C3C" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
