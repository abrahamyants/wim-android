<?xml version="1.0" encoding="utf-8"?>
<!-- Tiny gold bezel — third theme indicator. The bubble itself stays gunmetal
     in this theme (carbon fiber menu background); the indicator shows GOLD to
     match the "Gold" label and the gold accent color used throughout the theme. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#FFF0E8D8" />
                    <size android:width="34dp" android:height="34dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="18dp"
                        android:centerX="0.42"
                        android:centerY="0.38"
                        android:startColor="#FFF6D87C"
                        android:endColor="#FF8B6914" />
                    <stroke android:width="1dp" android:color="#FFB55050" />
                </shape>
            </item>
            <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="14dp"
                        android:centerX="0.45"
                        android:centerY="0.40"
                        android:startColor="#FFE5C45A"
                        android:endColor="#FF6E5310" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="18dp"
                        android:centerX="0.42"
                        android:centerY="0.38"
                        android:startColor="#FFF6D87C"
                        android:endColor="#FF8B6914" />
                    <stroke android:width="1dp" android:color="#FFB55050" />
                    <size android:width="34dp" android:height="34dp" />
                </shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="14dp"
                        android:centerX="0.45"
                        android:centerY="0.40"
                        android:startColor="#FFE5C45A"
                        android:endColor="#FF6E5310" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
