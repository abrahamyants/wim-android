<?xml version="1.0" encoding="utf-8"?>
<!-- Track with gold progress for sliders -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background track -->
    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <solid android:color="#FFB0B0B5" />
            <corners android:radius="2dp" />
            <size android:height="4dp" />
            <stroke android:width="1dp" android:color="#1A000000" />
        </shape>
    </item>
    <!-- Progress track — gold -->
    <item android:id="@android:id/progress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="#FFD4A574" />
                <corners android:radius="2dp" />
                <size android:height="4dp" />
            </shape>
        </clip>
    </item>
</layer-list>
