<?xml version="1.0" encoding="utf-8"?>
<!-- aluminum dish — silver ring around its lighter well. Tiny replica for the bubble menu (2026-09-06).
     state_selected = cream glow ring outside. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#FFF0E8D8" />
                    <size android:width="34dp" android:height="34dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="18dp"
                        android:centerX="0.42"
                        android:centerY="0.38"
                        android:startColor="#FFE0E0E4"
                        android:endColor="#FFB0B0B8" />
                    <stroke android:width="1dp" android:color="#FFB55050" />
                </shape>
            </item>
            <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="8dp"
                        android:centerX="0.45"
                        android:centerY="0.40"
                        android:startColor="#FFCCCCD2"
                        android:endColor="#FFA0A0A8" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="18dp"
                        android:centerX="0.42"
                        android:centerY="0.38"
                        android:startColor="#FFE0E0E4"
                        android:endColor="#FFB0B0B8" />
                    <stroke android:width="1dp" android:color="#FFB55050" />
                    <size android:width="34dp" android:height="34dp" />
                </shape>
            </item>
            <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="8dp"
                        android:centerX="0.45"
                        android:centerY="0.40"
                        android:startColor="#FFCCCCD2"
                        android:endColor="#FFA0A0A8" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
