<?xml version="1.0" encoding="utf-8"?>
<!-- Fader thumb for the OPACITY / SIZE sliders: a round dot, 14dp
     (2026-09-06; it was a 20dp square block). BubbleMenu tints it with the
     plate's accent, so the gradient here only shapes the light. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:startColor="#FFE0D4B0"
        android:centerColor="#FFC8B48A"
        android:endColor="#FF8A7656"
        android:angle="270" />
    <stroke android:width="0.7dp" android:color="#FF1A0F08" />
    <size android:width="14dp" android:height="14dp" />
</shape>
