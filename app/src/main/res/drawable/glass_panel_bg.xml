<?xml version="1.0" encoding="utf-8"?>
<!-- Section header — raised brushed aluminum, Floating Veyron style -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow underneath — raised off the surface -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#44000000" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Body — brushed aluminum gradient, light top to darker bottom -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#FFCDCDD4"
                android:endColor="#FFA5A5AE" />
            <corners android:radius="10dp" />
            <stroke android:width="0.5dp" android:color="#33000000" />
        </shape>
    </item>
    <!-- Top edge highlight — light catching the rim -->
    <item android:left="4dp" android:right="4dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#30FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="9dp" />
            <size android:height="6dp" />
        </shape>
    </item>
</layer-list>
