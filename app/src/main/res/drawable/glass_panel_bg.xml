<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass panel — darker aluminum with subtle transparency -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E8B8B8BC" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#22000000" />
        </shape>
    </item>
    <!-- Inner highlight -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#18FFFFFF" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</layer-list>
