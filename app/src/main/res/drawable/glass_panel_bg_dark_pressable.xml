<?xml version="1.0" encoding="utf-8"?>
<!-- Лаврентий light — Settings header -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFd4d4d8"
                android:centerColor="#FFdcdce0"
                android:endColor="#FFe4e4e8"
                android:angle="270" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#30000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFdcdce0"
                android:centerColor="#FFe4e4e8"
                android:endColor="#FFececf0"
                android:angle="270" />
            <corners android:radius="6dp" />
            <stroke android:width="0.5dp" android:color="#20000000" />
        </shape>
    </item>
</selector>
