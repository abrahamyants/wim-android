<?xml version="1.0" encoding="utf-8"?>
<!-- Pressable section header: shows pressed state on touch -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#FFB8B8C0"
                        android:endColor="#FF959598" />
                    <corners android:radius="10dp" />
                    <stroke android:width="0.5dp" android:color="#44000000" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <!-- Normal: same as glass_panel_bg -->
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#44000000" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#FFCDCDD4"
                        android:endColor="#FFA5A5AE" />
                    <corners android:radius="10dp" />
                    <stroke android:width="0.5dp" android:color="#33000000" />
                </shape>
            </item>
            <item android:left="4dp" android:right="4dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#30FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="9dp" />
                    <size android:height="6dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
