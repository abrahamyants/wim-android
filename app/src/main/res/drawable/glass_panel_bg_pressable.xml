<?xml version="1.0" encoding="utf-8"?>
<!-- Light mode — category header (darker than bg for contrast) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF9898A0"
                android:centerColor="#FFA0A0A8"
                android:endColor="#FFA8A8B0"
                android:angle="270" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#30000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFA8A8B0"
                android:centerColor="#FFB0B0B8"
                android:endColor="#FFB8B8C0"
                android:angle="270" />
            <corners android:radius="6dp" />
            <stroke android:width="0.5dp" android:color="#25000000" />
        </shape>
    </item>
</selector>
