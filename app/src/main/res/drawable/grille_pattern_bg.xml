<?xml version="1.0" encoding="utf-8"?>
<!-- Perforated metal grille — visible brushed texture for category content areas
     Reference: Лаврентий left panel background -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base: dark metal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF161620" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Brushed diagonal grain — direction 1, visible -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0EFFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#08FFFFFF"
                android:angle="135" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Brushed diagonal grain — direction 2, cross -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#06FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#0AFFFFFF"
                android:angle="225" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Horizontal band — subtle machining lines -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#05FFFFFF"
                android:centerColor="#02FFFFFF"
                android:endColor="#05FFFFFF"
                android:angle="0" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Inner shadow — recessed into body -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#20000000"
                android:endColor="#00000000"
                android:angle="270" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <!-- Machined border — visible edge -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#18FFFFFF" />
        </shape>
    </item>
</layer-list>
