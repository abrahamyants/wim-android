<?xml version="1.0" encoding="utf-8"?>
<!-- Category content grille — same mesh as sessions panel, neutral dark -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base dark -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF141420"
                android:centerColor="#FF1A1A28"
                android:endColor="#FF141420"
                android:angle="270" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Mesh tint overlay — subtle navy -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#18303050"
                android:centerColor="#0C202040"
                android:endColor="#14282848"
                android:angle="135" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Diagonal mesh line — direction 1 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0CFFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#08FFFFFF"
                android:angle="45" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Diagonal mesh line — direction 2 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#08FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#0CFFFFFF"
                android:angle="315" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Inset shadow — top edge recess -->
    <item android:left="2dp" android:top="1dp" android:right="2dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#40000000"
                android:centerColor="#10000000"
                android:endColor="#30000000"
                android:angle="270" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <!-- Border — machined edge -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#20FFFFFF" />
        </shape>
    </item>
</layer-list>
