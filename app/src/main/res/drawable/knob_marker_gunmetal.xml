<?xml version="1.0" encoding="utf-8"?>
<!-- gunmetal knob — dark brushed steel wall and face. Tiny replica for the bubble menu (2026-09-06).
     state_selected = cream glow ring outside. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#FFF0E8D8" />
                    <size android:width="34dp" android:height="34dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="18dp"
                        android:centerX="0.42"
                        android:centerY="0.38"
                        android:startColor="#FF4A4A54"
                        android:endColor="#FF26262C" />
                    <stroke android:width="0.5dp" android:color="#44000000" />
                </shape>
            </item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="12dp"
                        android:centerX="0.45"
                        android:centerY="0.40"
                        android:startColor="#FF5A5A64"
                        android:endColor="#FF38383E" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="18dp"
                        android:centerX="0.42"
                        android:centerY="0.38"
                        android:startColor="#FF4A4A54"
                        android:endColor="#FF26262C" />
                    <stroke android:width="0.5dp" android:color="#44000000" />
                    <size android:width="34dp" android:height="34dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="12dp"
                        android:centerX="0.45"
                        android:centerY="0.40"
                        android:startColor="#FF5A5A64"
                        android:endColor="#FF38383E" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
