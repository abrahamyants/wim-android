<?xml version="1.0" encoding="utf-8"?>
<!-- Лаврентий stat-cell — deep dark glass with warm inner glow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer frame -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF0a0a0e" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#993C3228" />
        </shape>
    </item>
    <!-- Inner glass — deep gradient -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF0c0c0e"
                android:centerColor="#FF141418"
                android:endColor="#FF0a0a0e"
                android:angle="270" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <!-- Warm orange inner glow — filament -->
    <!-- Outer halo — wide, soft -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="40dp"
                android:centerX="0.5"
                android:centerY="0.45"
                android:startColor="#30C49A6C"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Inner filament glow — tighter, brighter -->
    <item android:left="6dp" android:top="4dp" android:right="6dp" android:bottom="8dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="24dp"
                android:centerX="0.5"
                android:centerY="0.4"
                android:startColor="#50C49A6C"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Glass tube reflection — top diagonal -->
    <item android:left="3dp" android:top="1dp" android:right="10dp" android:bottom="20dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0AFFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="250" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- Top bevel — light catch -->
    <item android:left="4dp" android:top="0dp" android:right="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#08FFFFFF" />
            <size android:height="1dp" />
        </shape>
    </item>
</layer-list>
