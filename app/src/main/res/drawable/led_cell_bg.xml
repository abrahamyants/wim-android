<?xml version="1.0" encoding="utf-8"?>
<!-- Nixie tube — vintage vacuum glass, muted warm glow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Socket bezel — aged brass -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF302818"
                android:centerColor="#FF282014"
                android:endColor="#FF302818"
                android:angle="270" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="#FF3E3222" />
        </shape>
    </item>
    <!-- Inner socket recess -->
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF040303" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#FF221C14" />
        </shape>
    </item>
    <!-- Glass envelope — very dark, near black -->
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF060504"
                android:centerColor="#FF0A0806"
                android:endColor="#FF050403"
                android:angle="270" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <!-- Glass left edge — faint -->
    <item android:left="4dp" android:top="6dp" android:right="70dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0AFFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="0" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- Warm filament haze — very subtle, vintage -->
    <item android:left="10dp" android:top="6dp" android:right="10dp" android:bottom="12dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="36dp"
                android:centerX="0.5"
                android:centerY="0.4"
                android:startColor="#10C87840"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Top glass reflection — very faint -->
    <item android:left="8dp" android:top="3dp" android:right="8dp" android:bottom="30dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#08FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</layer-list>
