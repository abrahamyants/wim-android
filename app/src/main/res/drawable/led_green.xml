<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#4000CC44" />
            <size android:width="8dp" android:height="8dp" />
        </shape>
    </item>
    <!-- LED body -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="oval">
            <solid android:color="#FF00CC44" />
            <size android:width="6dp" android:height="6dp" />
        </shape>
    </item>
    <!-- Highlight -->
    <item android:left="2dp" android:top="1dp" android:right="3dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#4DFFFFFF" />
            <size android:width="3dp" android:height="3dp" />
        </shape>
    </item>
</layer-list>
