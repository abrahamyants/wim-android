<?xml version="1.0" encoding="utf-8"?>
<!-- One cell of the layer segmented control. Selected = maroon, the plate's
     one accent. Unselected = transparent over the frame's dark plate. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle"><solid android:color="#FFB55050" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#00000000" /></shape>
    </item>
</selector>
