<?xml version="1.0" encoding="utf-8"?>
<!-- Brass screw — bigger, visible Phillips head indentation, depth -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Drop shadow -->
    <item android:left="1dp" android:top="1dp">
        <shape android:shape="oval">
            <solid android:color="#60000000" />
            <size android:width="12dp" android:height="12dp" />
        </shape>
    </item>
    <!-- Screw body — raised brass -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="7dp"
                android:centerX="0.4"
                android:centerY="0.35"
                android:startColor="#FFFFE0A0"
                android:centerColor="#FFD4A574"
                android:endColor="#FF8A6848" />
            <stroke android:width="0.5dp" android:color="#40000000" />
            <size android:width="12dp" android:height="12dp" />
        </shape>
    </item>
    <!-- Phillips head slot — horizontal -->
    <item android:left="3dp" android:right="3dp" android:top="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#44000000" />
            <corners android:radius="1dp" />
            <size android:width="6dp" android:height="2dp" />
        </shape>
    </item>
    <!-- Phillips head slot — vertical -->
    <item android:left="5dp" android:right="5dp" android:top="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#44000000" />
            <corners android:radius="1dp" />
            <size android:width="2dp" android:height="6dp" />
        </shape>
    </item>
    <!-- Top highlight -->
    <item android:left="2dp" android:top="1dp" android:right="4dp" android:bottom="7dp">
        <shape android:shape="oval">
            <solid android:color="#18FFFFFF" />
        </shape>
    </item>
</layer-list>
