<?xml version="1.0" encoding="utf-8"?>
<!-- Brass screw — 40% smaller, Phillips head visible -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Drop shadow -->
    <item android:left="1dp" android:top="1dp">
        <shape android:shape="oval">
            <solid android:color="#50000000" />
            <size android:width="7dp" android:height="7dp" />
        </shape>
    </item>
    <!-- Screw body — raised brass -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="4dp"
                android:centerX="0.4"
                android:centerY="0.35"
                android:startColor="#FFFFE0A0"
                android:centerColor="#FFD4A574"
                android:endColor="#FF8A6848" />
            <stroke android:width="0.5dp" android:color="#40000000" />
            <size android:width="7dp" android:height="7dp" />
        </shape>
    </item>
    <!-- Phillips head slot — horizontal -->
    <item android:left="2dp" android:right="2dp" android:top="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#44000000" />
            <corners android:radius="0.5dp" />
            <size android:width="3dp" android:height="1dp" />
        </shape>
    </item>
    <!-- Phillips head slot — vertical -->
    <item android:left="3dp" android:right="3dp" android:top="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#44000000" />
            <corners android:radius="0.5dp" />
            <size android:width="1dp" android:height="3dp" />
        </shape>
    </item>
    <!-- Top highlight -->
    <item android:left="1dp" android:top="1dp" android:right="3dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#18FFFFFF" />
        </shape>
    </item>
</layer-list>
