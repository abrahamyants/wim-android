<?xml version="1.0" encoding="utf-8"?>
<!-- Лаврентий light — sessions panel (console-bg lighter maroon) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF5c2a2a"
                android:centerColor="#FF4a2020"
                android:endColor="#FF3e1818"
                android:angle="270" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="1dp" android:right="2dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#30000000"
                android:endColor="#00000000"
                android:angle="270" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="8dp" />
            <stroke android:width="0.5dp" android:color="#1A000000" />
        </shape>
    </item>
</layer-list>
