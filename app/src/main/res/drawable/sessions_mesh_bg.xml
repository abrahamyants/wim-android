<?xml version="1.0" encoding="utf-8"?>
<!-- Лаврентий console-bg — #3a1a1a dark maroon -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base maroon — Лаврентий console -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF3a1a1a"
                android:centerColor="#FF2e1414"
                android:endColor="#FF281010"
                android:angle="270" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Inset shadow -->
    <item android:left="2dp" android:top="1dp" android:right="2dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#40000000"
                android:endColor="#00000000"
                android:angle="270" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <!-- Border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="8dp" />
            <stroke android:width="0.5dp" android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
