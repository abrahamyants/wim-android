<?xml version="1.0" encoding="utf-8"?>
<!-- Speaker cone — deeper shading and more depth like Лаврентий -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="300dp"
    android:height="300dp"
    android:viewportWidth="400"
    android:viewportHeight="400"
    android:alpha="0.30">

    <!-- Outer frame ring — heavier -->
    <path
        android:pathData="M200,200m-196,0a196,196 0,1 1,392 0a196,196 0,1 1,-392 0"
        android:strokeColor="#606060"
        android:strokeWidth="10"
        android:fillColor="@android:color/transparent" />

    <!-- Frame screws (8 around perimeter) -->
    <path android:pathData="M200,8m-5,0a5,5 0,1 1,10 0a5,5 0,1 1,-10 0" android:fillColor="#777777" />
    <path android:pathData="M336,56m-5,0a5,5 0,1 1,10 0a5,5 0,1 1,-10 0" android:fillColor="#777777" />
    <path android:pathData="M392,200m-5,0a5,5 0,1 1,10 0a5,5 0,1 1,-10 0" android:fillColor="#777777" />
    <path android:pathData="M336,344m-5,0a5,5 0,1 1,10 0a5,5 0,1 1,-10 0" android:fillColor="#777777" />
    <path android:pathData="M200,392m-5,0a5,5 0,1 1,10 0a5,5 0,1 1,-10 0" android:fillColor="#777777" />
    <path android:pathData="M64,344m-5,0a5,5 0,1 1,10 0a5,5 0,1 1,-10 0" android:fillColor="#777777" />
    <path android:pathData="M8,200m-5,0a5,5 0,1 1,10 0a5,5 0,1 1,-10 0" android:fillColor="#777777" />
    <path android:pathData="M64,56m-5,0a5,5 0,1 1,10 0a5,5 0,1 1,-10 0" android:fillColor="#777777" />

    <!-- Surround ring (rubber) — thicker, darker -->
    <path
        android:pathData="M200,200m-172,0a172,172 0,1 1,344 0a172,172 0,1 1,-344 0"
        android:strokeColor="#555555"
        android:strokeWidth="36"
        android:fillColor="@android:color/transparent" />

    <!-- Inner ring edge — highlight -->
    <path
        android:pathData="M200,200m-153,0a153,153 0,1 1,306 0a153,153 0,1 1,-306 0"
        android:strokeColor="#5A5A5A"
        android:strokeWidth="4"
        android:fillColor="@android:color/transparent" />

    <!-- Cone body — darker for depth -->
    <path
        android:pathData="M200,200m-150,0a150,150 0,1 1,300 0a150,150 0,1 1,-300 0"
        android:fillColor="#686868" />

    <!-- Cone inner shadow ring -->
    <path
        android:pathData="M200,200m-120,0a120,120 0,1 1,240 0a120,120 0,1 1,-240 0"
        android:strokeColor="#505050"
        android:strokeWidth="2"
        android:fillColor="@android:color/transparent" />

    <!-- Cone shading — mid ring -->
    <path
        android:pathData="M200,200m-100,0a100,100 0,1 1,200 0a100,100 0,1 1,-200 0"
        android:strokeColor="#585858"
        android:strokeWidth="1"
        android:fillColor="@android:color/transparent" />

    <!-- Dust cap edge — more prominent -->
    <path
        android:pathData="M200,200m-52,0a52,52 0,1 1,104 0a52,52 0,1 1,-104 0"
        android:strokeColor="#505050"
        android:strokeWidth="4"
        android:fillColor="@android:color/transparent" />

    <!-- Dust cap — raised center -->
    <path
        android:pathData="M200,200m-48,0a48,48 0,1 1,96 0a48,48 0,1 1,-96 0"
        android:fillColor="#7A7A7A" />

    <!-- Dust cap highlight -->
    <path
        android:pathData="M190,185m-20,0a20,18 0,1 1,40 0a20,18 0,1 1,-40 0"
        android:fillColor="#10FFFFFF" />

</vector>
