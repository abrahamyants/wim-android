<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="120dp"
    android:layout_height="120dp"
    android:id="@+id/bubbleRoot"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Pulse rings (behind bezel, animate outward) -->
    <View
        android:id="@+id/ring1"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:background="@drawable/pulse_ring"
        android:alpha="0" />

    <View
        android:id="@+id/ring2"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:background="@drawable/pulse_ring"
        android:alpha="0" />

    <View
        android:id="@+id/ring3"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:background="@drawable/pulse_ring_outer"
        android:alpha="0" />

    <!-- Outer raised bezel ring -->
    <FrameLayout
        android:id="@+id/bubbleBezel"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:background="@drawable/bubble_bg_idle"
        android:elevation="8dp">

        <!-- Clarifier: split bezel backgrounds (green left, red right) — hidden by default -->
        <View
            android:id="@+id/clarifierBgYes"
            android:layout_width="36dp"
            android:layout_height="72dp"
            android:layout_gravity="start"
            android:background="@drawable/clarifier_half_yes"
            android:visibility="gone"
            android:clipChildren="true" />

        <View
            android:id="@+id/clarifierBgNo"
            android:layout_width="36dp"
            android:layout_height="72dp"
            android:layout_gravity="end"
            android:background="@drawable/clarifier_half_no"
            android:visibility="gone"
            android:clipChildren="true" />

        <!-- Clarifier: checkmark (left) and X (right) — white on colored bg -->
        <TextView
            android:id="@+id/bezelYes"
            android:layout_width="18dp"
            android:layout_height="24dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="1dp"
            android:gravity="center"
            android:text="✓"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:visibility="gone"
            android:clickable="false"
            android:focusable="false" />

        <TextView
            android:id="@+id/bezelNo"
            android:layout_width="18dp"
            android:layout_height="24dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="1dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:visibility="gone"
            android:clickable="false"
            android:focusable="false" />

        <!-- Inner sunken well -->
        <FrameLayout
            android:id="@+id/bubbleInner"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:background="@drawable/bubble_inner_knob">

            <!-- Tick mark — volume knob indicator, 12 o'clock on inner circle -->
            <View
                android:id="@+id/bubbleTick"
                android:layout_width="3dp"
                android:layout_height="8dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="2dp"
                android:background="@drawable/knob_tick" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <TextView
                    android:id="@+id/bubbleLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="IDLE"
                    android:textColor="#FF555560"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.05"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/bubbleTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#FFEE5A24"
                    android:textSize="8sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:textStyle="bold" />

            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
