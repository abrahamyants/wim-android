<?xml version="1.0" encoding="utf-8"?>
<!--
    Bubble color picker dialog. Each preview mirrors bubble.xml exactly:
    bezel (84dp) + inner knob (52dp) + tick mark + IDLE label. So the
    user sees what the floating bubble will actually look like in real
    use, not a stylized preview. Tap any preview to commit + close.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PICK A BUBBLE"
        android:textColor="@color/section_header"
        android:textSize="14sp"
        android:fontFamily="@font/geist_bold"
        android:textAllCaps="true"
        android:letterSpacing="0.18"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- BRONZE — full mirror of bubble.xml: bezel + knob + tick + IDLE -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:id="@+id/pickerBronze"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bubble_bg_idle"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/bubble_color_bronze">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bubble_inner_knob">

                    <!-- Tick mark — 12 o'clock indicator on knob, scaled
                         from real bubble's 3dp×8dp to 4dp×10dp for the
                         slightly-bigger picker preview. -->
                    <View
                        android:layout_width="4dp"
                        android:layout_height="10dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="3dp"
                        android:background="@drawable/knob_tick" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="IDLE"
                        android:textColor="#FF1F1208"
                        android:textSize="10sp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:letterSpacing="0.05"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:maxLines="1" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bronze"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:letterSpacing="0.1"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- ALUMINUM -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:id="@+id/pickerAluminum"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bubble_bezel_aluminum"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/bubble_color_silver">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bubble_knob_aluminum">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="10dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="3dp"
                        android:background="@drawable/knob_tick" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="IDLE"
                        android:textColor="#FF555560"
                        android:textSize="10sp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:letterSpacing="0.05"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:maxLines="1" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aluminum"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:letterSpacing="0.1"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- GUNMETAL -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:id="@+id/pickerGunmetal"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bubble_bezel_gunmetal"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/bubble_color_gunmetal">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bubble_knob_gunmetal">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="10dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="3dp"
                        android:background="@drawable/knob_tick" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="IDLE"
                        android:textColor="#FFC8B48A"
                        android:textSize="10sp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:letterSpacing="0.05"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:maxLines="1" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gunmetal"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:letterSpacing="0.1"
                android:layout_marginTop="10dp" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
