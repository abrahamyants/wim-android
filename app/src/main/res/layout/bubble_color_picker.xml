<?xml version="1.0" encoding="utf-8"?>
<!--
    Bubble color picker dialog content. Three full-size bubble previews
    (bezel + knob, mirroring the floating-bubble structure) sit in a row.
    Tapping any preview commits the theme + closes the dialog.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PICK A BUBBLE"
        android:textColor="@color/section_header"
        android:textSize="14sp"
        android:fontFamily="@font/limelight"
        android:textAllCaps="true"
        android:letterSpacing="0.18"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- BRONZE -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:id="@+id/pickerBronze"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bubble_bg_idle"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bubble_inner_knob" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bronze"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- ALUMINUM -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:id="@+id/pickerAluminum"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bubble_bezel_aluminum"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bubble_knob_aluminum" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aluminum"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- GUNMETAL -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:id="@+id/pickerGunmetal"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bubble_bezel_gunmetal"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bubble_knob_gunmetal" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gunmetal"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:layout_marginTop="10dp" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
