<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menuRoot"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:elevation="14dp"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="22dp">

    <!-- Opacity slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/menuOpacityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Opacity"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginEnd="6dp"
            android:minWidth="56dp" />

        <SeekBar
            android:id="@+id/menuOpacitySeek"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:min="20"
            android:max="100"
            android:progress="70" />

        <TextView
            android:id="@+id/menuOpacityValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="70%"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginStart="4dp"
            android:minWidth="34dp"
            android:gravity="end" />
    </LinearLayout>

    <!-- Size slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/menuSizeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Size"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginEnd="6dp"
            android:minWidth="56dp" />

        <SeekBar
            android:id="@+id/menuSizeSeek"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:min="70"
            android:max="150"
            android:progress="110" />

        <TextView
            android:id="@+id/menuSizeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="110%"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginStart="4dp"
            android:minWidth="34dp"
            android:gravity="end" />
    </LinearLayout>

    <!-- Live transcript toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/menuLiveLabel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Live transcribe"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/menuLiveToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Layer selector — vertical stack: Transcription / Reconstruction / Speech Disfluency Nuancing -->
    <TextView
        android:id="@+id/menuLayerLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Layer"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/menuLayer1"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:text="Transcription"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:gravity="center" />

    <TextView
        android:id="@+id/menuLayer2"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:text="Reconstruction"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:gravity="center" />

    <TextView
        android:id="@+id/menuLayer4"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:text="Speech Disfluency Nuancing"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:gravity="center"
        android:layout_marginBottom="6dp" />

    <!-- Bubble color -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/menuColorLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Color"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginEnd="6dp"
            android:minWidth="56dp" />

        <TextView
            android:id="@+id/menuThemeBronze"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="24dp"
            android:text="Bronze"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:gravity="center" />
        <TextView
            android:id="@+id/menuThemeAluminum"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="24dp"
            android:text="Silver"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:gravity="center" />
        <TextView
            android:id="@+id/menuThemeGunmetal"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="24dp"
            android:text="Gunmetal"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:id="@+id/menuDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="4dp" />

    <!-- Reset Timer -->
    <TextView
        android:id="@+id/menuResetTimer"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:text="Reset Timer"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:gravity="center" />

    <!-- Open Settings -->
    <TextView
        android:id="@+id/menuOpenSettings"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:text="Settings"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:gravity="center" />

</LinearLayout>
