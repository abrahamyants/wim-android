<?xml version="1.0" encoding="utf-8"?>
<!-- Vintage hi-fi control plate.
     Concept: the menu is the inside of the bubble's chassis pulled open.
     - Layer / Reset / Settings = engraved nameplates
     - Color picker = three tiny replicas of the bubble bezel itself
     - Sliders = real fader knobs (vertical, on the side)
     - Section labels = engraved panel titles
     - Reset Timer + Settings flank the speech-bubble tail at the bottom -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menuRoot"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:elevation="14dp"
    android:paddingStart="14dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="22dp">

    <!-- Anticipatory prediction chip — shown when PredictionEngine has a
         high-confidence guess for the current foreground app + time of
         day. Hidden when no prediction or predictions are disabled. -->
    <TextView
        android:id="@+id/menuPredictionChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text=""
        android:textSize="9sp"
        android:fontFamily="@font/josefin_sans"
        android:textStyle="bold"
        android:letterSpacing="0.16"
        android:visibility="gone" />

    <!-- TOP ROW: chips/colors on the left, vertical sliders on the right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- LEFT COLUMN: nameplates + color picker -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Live transcript toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="0dp">

                <TextView
                    android:id="@+id/menuLiveLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="LIVE"
                    android:textSize="12sp"
                    android:fontFamily="@font/josefin_sans"
                    android:textStyle="bold"
                    android:letterSpacing="0.20" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/menuLiveToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- L1 CLOUD toggle moved to a sub-menu opened by tapping the
                 TRANSCRIPTION layer nameplate. Frees a whole row from this menu. -->

            <!-- LAYER section label -->
            <TextView
                android:id="@+id/menuLayerLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LAYER"
                android:textSize="11sp"
                android:fontFamily="@font/josefin_sans"
                android:textStyle="bold"
                android:letterSpacing="0.30"
                android:layout_marginBottom="2dp" />

            <!-- Layer engraved nameplates -->
            <TextView
                android:id="@+id/menuLayer1"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:text="TRANSCRIPTION"
                android:textSize="10sp"
                android:fontFamily="@font/josefin_sans"
                android:textStyle="bold"
                android:gravity="center"
                android:letterSpacing="0.18"
                android:background="@drawable/nameplate_bg"
                android:layout_marginBottom="3dp" />

            <!-- L1 source sub-row: Local / Cloud, indented under TRANSCRIPTION.
                 Visible whenever the menu is open; the active source is
                 highlighted via the nameplate_bg state_selected layer. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="3dp">

                <TextView
                    android:id="@+id/menuL1Local"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="22dp"
                    android:text="LOCAL"
                    android:textSize="9sp"
                    android:fontFamily="@font/josefin_sans"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:letterSpacing="0.20"
                    android:background="@drawable/nameplate_bg"
                    android:layout_marginEnd="3dp" />

                <TextView
                    android:id="@+id/menuL1Cloud"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="22dp"
                    android:text="CLOUD"
                    android:textSize="9sp"
                    android:fontFamily="@font/josefin_sans"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:letterSpacing="0.20"
                    android:background="@drawable/nameplate_bg"
                    android:layout_marginStart="3dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/menuLayer2"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:text="RECONSTRUCTION"
                android:textSize="10sp"
                android:fontFamily="@font/josefin_sans"
                android:textStyle="bold"
                android:gravity="center"
                android:letterSpacing="0.16"
                android:background="@drawable/nameplate_bg"
                android:layout_marginBottom="3dp" />

            <TextView
                android:id="@+id/menuLayer4"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:text="DISFLUENCY"
                android:textSize="10sp"
                android:fontFamily="@font/josefin_sans"
                android:textStyle="bold"
                android:gravity="center"
                android:letterSpacing="0.20"
                android:background="@drawable/nameplate_bg"
                android:layout_marginBottom="6dp" />

            <!-- COLOR row — label + 3 swatches inline (saves vertical space) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/menuColorLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="COLOR"
                    android:textSize="11sp"
                    android:fontFamily="@font/josefin_sans"
                    android:textStyle="bold"
                    android:letterSpacing="0.30" />

                <View
                    android:id="@+id/menuThemeBronze"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/color_indicator_bronze"
                    android:layout_marginStart="6dp"
                    android:contentDescription="Bronze" />
                <View
                    android:id="@+id/menuThemeAluminum"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/color_indicator_silver"
                    android:layout_marginStart="6dp"
                    android:contentDescription="Silver" />
                <View
                    android:id="@+id/menuThemeGunmetal"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/color_indicator_gunmetal"
                    android:layout_marginStart="6dp"
                    android:contentDescription="Gunmetal" />
            </LinearLayout>
        </LinearLayout>

        <!-- RIGHT COLUMN: vertical fader sliders -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:layout_marginStart="10dp"
            android:gravity="top">

            <!-- Opacity fader -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/menuOpacityLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OP"
                    android:textSize="9sp"
                    android:fontFamily="@font/josefin_sans"
                    android:textStyle="bold"
                    android:letterSpacing="0.20"
                    android:layout_marginBottom="2dp" />

                <com.wim.app.VerticalSeekBar
                    android:id="@+id/menuOpacitySeek"
                    android:layout_width="26dp"
                    android:layout_height="170dp"
                    android:min="20"
                    android:max="100"
                    android:progress="70"
                    android:thumb="@drawable/fader_thumb"
                    android:splitTrack="false"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp" />

                <TextView
                    android:id="@+id/menuOpacityValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="70"
                    android:textSize="10sp"
                    android:fontFamily="@font/josefin_sans"
                    android:textStyle="bold"
                    android:layout_marginTop="0dp" />
            </LinearLayout>

            <!-- Size fader -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="2dp">

                <TextView
                    android:id="@+id/menuSizeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SZ"
                    android:textSize="9sp"
                    android:fontFamily="@font/josefin_sans"
                    android:textStyle="bold"
                    android:letterSpacing="0.20"
                    android:layout_marginBottom="2dp" />

                <com.wim.app.VerticalSeekBar
                    android:id="@+id/menuSizeSeek"
                    android:layout_width="26dp"
                    android:layout_height="170dp"
                    android:min="70"
                    android:max="150"
                    android:progress="110"
                    android:thumb="@drawable/fader_thumb"
                    android:splitTrack="false"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp" />

                <TextView
                    android:id="@+id/menuSizeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="110"
                    android:textSize="10sp"
                    android:fontFamily="@font/josefin_sans"
                    android:textStyle="bold"
                    android:layout_marginTop="0dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- BOTTOM ROW: Settings (right-aligned). Reset Timer removed
         (timer relocated to Sessions console next to "Today" header). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/menuOpenSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SETTINGS"
            android:textSize="11sp"
            android:fontFamily="@font/josefin_sans"
            android:textStyle="bold"
            android:letterSpacing="0.22"
            android:padding="4dp" />
    </LinearLayout>
</LinearLayout>
