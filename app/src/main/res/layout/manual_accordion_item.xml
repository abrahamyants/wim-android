<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="2dp">

    <!-- Header row: icon + title/subtitle + chevron -->
    <LinearLayout
        android:id="@+id/accordionHeader"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/card_bg"
        android:paddingStart="12dp"
        android:paddingEnd="14dp">

        <!-- Icon circle -->
        <TextView
            android:id="@+id/accordionIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="@color/text_white"
            android:background="@drawable/icon_circle"
            android:layout_marginEnd="10dp" />

        <!-- Title + subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/accordionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/accordionSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/red_bright"
                android:textSize="9sp"
                android:fontFamily="@font/plus_jakarta_sans" />
        </LinearLayout>

        <!-- Chevron -->
        <TextView
            android:id="@+id/accordionChevron"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▸"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Expandable content -->
    <LinearLayout
        android:id="@+id/accordionContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="14dp"
        android:layout_marginTop="1dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/accordionBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/red_bright"
            android:textSize="11sp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>

</LinearLayout>
