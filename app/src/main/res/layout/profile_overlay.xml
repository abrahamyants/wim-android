<?xml version="1.0" encoding="utf-8"?>
<!-- Iron Curtain — full-screen profile overlay, slides in from right -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0222228"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="40dp"
        android:paddingBottom="24dp">

        <!-- Header row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/profile_title"
                android:textColor="@color/copper_gold"
                android:textSize="16sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/profileClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"
                android:textColor="@color/text_secondary"
                android:textSize="22sp"
                android:fontFamily="monospace"
                android:paddingStart="16dp"
                android:paddingEnd="4dp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbarThumbVertical="@android:color/transparent">

            <LinearLayout
                android:id="@+id/profileContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Usage mode -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_mostly_use_for"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/profileUsageGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/profileWorkOnly"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="@string/profile_use_work"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:background="@drawable/card_bg"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/profileLifeOnly"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="@string/profile_use_life"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:background="@drawable/card_bg"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/profileBoth"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="@string/profile_use_both"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:background="@drawable/card_bg" />
                </LinearLayout>

                <!-- Work/Life balance slider — visible when "Both" is selected -->
                <LinearLayout
                    android:id="@+id/balanceSliderRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="W"
                        android:textColor="#FFAADDFF"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                    <SeekBar
                        android:id="@+id/balanceSeek"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="50"
                        android:progressTint="@color/orange_label"
                        android:thumbTint="@color/copper_gold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="L"
                        android:textColor="#FFFFCC88"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:id="@+id/balanceValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_use_5050"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Industry -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_industry"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/profileIndustryGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <!-- Row 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView android:id="@+id/indFinance" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:gravity="center" android:text="@string/profile_ind_finance" android:textColor="@color/text_dim" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/card_bg" android:layout_marginEnd="4dp" />
                        <TextView android:id="@+id/indLegal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:gravity="center" android:text="@string/profile_ind_legal" android:textColor="@color/text_dim" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/card_bg" android:layout_marginEnd="4dp" />
                        <TextView android:id="@+id/indMedical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:gravity="center" android:text="@string/profile_ind_medical" android:textColor="@color/text_dim" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/card_bg" />
                    </LinearLayout>

                    <!-- Row 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView android:id="@+id/indTech" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:gravity="center" android:text="@string/profile_ind_tech" android:textColor="@color/text_dim" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/card_bg" android:layout_marginEnd="4dp" />
                        <TextView android:id="@+id/indSales" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:gravity="center" android:text="@string/profile_ind_sales" android:textColor="@color/text_dim" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/card_bg" android:layout_marginEnd="4dp" />
                        <TextView android:id="@+id/indTrades" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:gravity="center" android:text="@string/profile_ind_trades" android:textColor="@color/text_dim" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/card_bg" />
                    </LinearLayout>

                    <!-- Row 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView android:id="@+id/indFood" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:gravity="center" android:text="@string/profile_ind_food" android:textColor="@color/text_dim" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/card_bg" android:layout_marginEnd="4dp" />
                        <TextView android:id="@+id/indEducation" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:gravity="center" android:text="@string/profile_ind_education" android:textColor="@color/text_dim" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/card_bg" android:layout_marginEnd="4dp" />
                        <TextView android:id="@+id/indOther" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:gravity="center" android:text="@string/profile_ind_other" android:textColor="@color/text_dim" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/card_bg" />
                    </LinearLayout>

                    <!-- Other industry text input — hidden until "Other" is tapped -->
                    <EditText
                        android:id="@+id/indOtherInput"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:hint="@string/profile_industry_hint"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:background="@drawable/card_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:inputType="text"
                        android:imeOptions="actionDone"
                        android:maxLines="1"
                        android:visibility="gone"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Speech section removed — layer selection covers this -->

                <!-- L1 / first language — drives the L1-transfer pack (russian/spanish/mandarin v1) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_native_english"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/profileL1NativeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView android:id="@+id/l1NativeYes" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:gravity="center" android:text="@string/profile_yes" android:textColor="@color/text_dim" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/card_bg" android:layout_marginEnd="4dp" />
                    <TextView android:id="@+id/l1NativeNo" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:gravity="center" android:text="@string/profile_no" android:textColor="@color/text_dim" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/card_bg" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/profileL1LanguageGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_first_language"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView android:id="@+id/l1Russian" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:gravity="center" android:text="@string/profile_l1_russian" android:textColor="@color/text_dim" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/card_bg" android:layout_marginEnd="4dp" />
                        <TextView android:id="@+id/l1Spanish" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:gravity="center" android:text="@string/profile_l1_spanish" android:textColor="@color/text_dim" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/card_bg" android:layout_marginEnd="4dp" />
                        <TextView android:id="@+id/l1Mandarin" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:gravity="center" android:text="@string/profile_l1_mandarin" android:textColor="@color/text_dim" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/card_bg" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/l1Other"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="@string/profile_l1_other"
                        android:textColor="@color/text_dim"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:background="@drawable/card_bg" />
                </LinearLayout>

                <!-- Work hours -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_work_hours"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <TextView android:id="@+id/hoursMorning" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:gravity="center" android:text="@string/profile_hours_morning" android:textColor="@color/text_dim" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/card_bg" android:layout_marginEnd="4dp" />
                    <TextView android:id="@+id/hoursDay" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:gravity="center" android:text="@string/profile_hours_day" android:textColor="@color/text_dim" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/card_bg" android:layout_marginEnd="4dp" />
                    <TextView android:id="@+id/hoursEvening" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:gravity="center" android:text="@string/profile_hours_evening" android:textColor="@color/text_dim" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/card_bg" android:layout_marginEnd="4dp" />
                    <TextView android:id="@+id/hoursFlexible" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:gravity="center" android:text="@string/profile_hours_flexible" android:textColor="@color/text_dim" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/card_bg" />
                </LinearLayout>

                <!-- VOCABULARY — wrap-flow chips, all visible (no scroll) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_vocabulary"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/vocabChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleLine="false"
                    app:chipSpacingHorizontal="4dp"
                    app:chipSpacingVertical="2dp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">
                    <EditText
                        android:id="@+id/vocabAddInput"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="36dp"
                        android:hint="@string/profile_vocab_hint"
                        android:textColor="@color/active_text"
                        android:textColorHint="@color/active_text"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:background="@drawable/card_bg_input"
                        android:paddingStart="14dp"
                        android:paddingEnd="10dp"
                        android:inputType="text"
                        android:imeOptions="actionDone"
                        android:maxLines="1" />
                    <TextView
                        android:id="@+id/vocabAddBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/profile_add"
                        android:textColor="@color/active_text"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:background="@drawable/card_bg_input"
                        android:layout_marginStart="4dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- CORRECTIONS — wrap-flow chips ("wrong → right") -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_corrections"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/corrChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleLine="false"
                    app:chipSpacingHorizontal="4dp"
                    app:chipSpacingVertical="2dp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">
                    <EditText
                        android:id="@+id/corrAddFrom"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="36dp"
                        android:hint="@string/profile_correction_wrong_hint"
                        android:textColor="@color/active_text"
                        android:textColorHint="@color/active_text"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:background="@drawable/card_bg_input"
                        android:paddingStart="14dp"
                        android:paddingEnd="10dp"
                        android:inputType="text"
                        android:imeOptions="actionNext"
                        android:maxLines="1" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="→"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp" />
                    <EditText
                        android:id="@+id/corrAddTo"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="36dp"
                        android:hint="@string/profile_correction_right_hint"
                        android:textColor="@color/active_text"
                        android:textColorHint="@color/active_text"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:background="@drawable/card_bg_input"
                        android:paddingStart="14dp"
                        android:paddingEnd="10dp"
                        android:inputType="text"
                        android:imeOptions="actionDone"
                        android:maxLines="1" />
                    <TextView
                        android:id="@+id/corrAddBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/profile_add"
                        android:textColor="@color/active_text"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:background="@drawable/card_bg_input"
                        android:layout_marginStart="4dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- TRIGGER WORDS — wrap-flow chips -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_trigger_words"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/triggerChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleLine="false"
                    app:chipSpacingHorizontal="4dp"
                    app:chipSpacingVertical="2dp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">
                    <EditText
                        android:id="@+id/triggerAddInput"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="36dp"
                        android:hint="@string/profile_trigger_hint"
                        android:textColor="@color/active_text"
                        android:textColorHint="@color/active_text"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:background="@drawable/card_bg_input"
                        android:paddingStart="14dp"
                        android:paddingEnd="10dp"
                        android:inputType="text"
                        android:imeOptions="actionDone"
                        android:maxLines="1" />
                    <TextView
                        android:id="@+id/triggerAddBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/profile_add"
                        android:textColor="@color/active_text"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:background="@drawable/card_bg_input"
                        android:layout_marginStart="4dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- CLARIFIER SENSITIVITY — three-button low/medium/high -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_clarifier_sensitivity"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:id="@+id/clarSensLow"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="@string/profile_sens_low"
                        android:textColor="@color/text_dim"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:background="@drawable/card_bg"
                        android:layout_marginEnd="4dp" />
                    <TextView
                        android:id="@+id/clarSensMedium"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="@string/profile_sens_medium"
                        android:textColor="@color/text_dim"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:background="@drawable/card_bg"
                        android:layout_marginEnd="4dp" />
                    <TextView
                        android:id="@+id/clarSensHigh"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="@string/profile_sens_high"
                        android:textColor="@color/text_dim"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:background="@drawable/card_bg" />
                </LinearLayout>

                <!-- CLARIFIER NO-FLAG APPS — apps where the clarifier never
                     fires (banking, password managers, code editors). Tap
                     ADD CURRENT APP to capture whichever app the user just
                     came from; chip × removes. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_no_flag_apps"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/clarBlacklistChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleLine="false"
                    app:chipSpacingHorizontal="4dp"
                    app:chipSpacingVertical="2dp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">
                    <TextView
                        android:id="@+id/clarBlacklistAddBtn"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:text="@string/profile_add_current_app"
                        android:textColor="@color/active_text"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/card_bg_input"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- YOUR DATA (GDPR/CCPA rights) — only shown when signed in -->
                <LinearLayout
                    android:id="@+id/dataRightsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_your_data"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_data_synced"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/exportDataBtn"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="@string/profile_export_data"
                        android:textColor="@color/text_bright"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:background="@drawable/card_bg_pressable"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/deleteDataBtn"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="@string/profile_delete_data"
                        android:textColor="@color/red_hot"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:background="@drawable/card_bg_pressable" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
