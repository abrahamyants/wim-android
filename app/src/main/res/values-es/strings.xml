    <string name="bouncer_free">Gratis</string>
    <string name="bouncer_free_desc">Transcripción en el dispositivo. Limpia muletillas y disfluencias. Siempre gratis, funciona sin conexión.</string>
    <string name="bouncer_upgrade">Mejorar</string>
    <string name="bouncer_upgrade_desc">La reconstrucción con IA reescribe tu habla con el tono adecuado. Aprende tu vocabulario. Soporte completo de disfluencia.</string>
    <string name="bouncer_use_most">¿Cómo usarás WiM con más frecuencia?</string>
    <string name="bouncer_use_work">Trabajo</string>
    <string name="bouncer_use_work_desc">Tono profesional. Claridad de negocios. Correos, Slack, reuniones.</string>
    <string name="bouncer_use_personal">Personal</string>
    <string name="bouncer_use_personal_desc">Tono casual. Ritmo natural. Mensajes, redes, día a día.</string>
    <string name="bouncer_use_both">Ambos</string>
    <string name="bouncer_use_both_desc">WiM se adapta automáticamente. Profesional para apps de trabajo, casual en el resto.</string>
    <string name="bouncer_next_meet_bubble">siguiente: conoce la burbuja</string>
    <string name="bouncer_meet_bubble">Conoce la burbuja</string>
    <string name="bouncer_bubble_intro">El botón flotante vive sobre cada app. Es tu asistente de voz — siempre a un toque.</string>
    <string name="bouncer_gesture_tap">Toca</string>
    <string name="bouncer_gesture_tap_action">grabar / parar</string>
    <string name="bouncer_gesture_hold">Mantén</string>
    <string name="bouncer_gesture_hold_action">graba mientras lo mantienes</string>
    <string name="bouncer_gesture_doubletap">Doble toque</string>
    <string name="bouncer_gesture_doubletap_action">menú de ajustes</string>
    <string name="bouncer_gesture_drag">Arrastra</string>
    <string name="bouncer_gesture_drag_action">muévela donde sea</string>
    <string name="bouncer_gesture_fling">Lanza al fondo</string>
    <string name="bouncer_gesture_fling_action">descartar</string>
    <string name="bouncer_gesture_shake">Agita 2x</string>
    <string name="bouncer_gesture_shake_action">tráela de vuelta</string>
    <string name="bouncer_recon_title">Lo que dices vs. lo que llega</string>
    <string name="bouncer_recon_you_say">Dices:</string>
    <string name="bouncer_recon_arrives">Lo que llega:</string>
    <string name="bouncer_recon_before">eh, o sea, este, ¿puedes mandarme el reporte? lo necesito para, eh, la reunión de mañana, creo</string>
    <string name="bouncer_recon_after">¿Podrías enviarme el reporte? Lo necesito para la reunión de mañana.</string>
    <string name="bouncer_recon_caption">Disfluencias reconstruidas. Tono aplicado. El texto llega a la app donde estás escribiendo.</string>
    <string name="bouncer_send_title">Envía directo desde la burbuja</string>
    <string name="bouncer_send_body">Cuando llega tu texto, la burbuja se vuelve verde por 5 segundos. Tócala para enviar. Espera o toca afuera para cancelar.\n\nWiM nunca envía sin ese toque separado. El texto pasa por la app abierta — Mensajes, Gmail, WhatsApp, etc. — usando tu sesión iniciada.</string>
    <string name="bouncer_send_ack">Entiendo. Tocar la burbuja verde envía mi texto.</string>
    <string name="bouncer_next">Siguiente</string>
    <string name="bouncer_all_set">Todo listo.</string>
    <string name="bouncer_ready_body">WiM está listo.\n\nLa burbuja flotante aparecerá en tu pantalla. Abre cualquier app, toca la burbuja y habla.</string>
