    <string name="bouncer_free">Gratuit</string>
    <string name="bouncer_free_desc">Transcription sur l\'appareil. Nettoie les hésitations et les dysfluences. Toujours gratuit, fonctionne hors ligne.</string>
    <string name="bouncer_upgrade">Premium</string>
    <string name="bouncer_upgrade_desc">La reconstruction par IA réécrit votre parole avec le bon ton. Apprend votre vocabulaire. Soutien complet pour les dysfluences.</string>
    <string name="bouncer_use_most">Comment allez-vous utiliser WiM le plus ?</string>
    <string name="bouncer_use_work">Travail</string>
    <string name="bouncer_use_work_desc">Ton professionnel. Clarté professionnelle. E-mails, Slack, réunions.</string>
    <string name="bouncer_use_personal">Personnel</string>
    <string name="bouncer_use_personal_desc">Ton décontracté. Rythme naturel. Messages, réseaux sociaux, quotidien.</string>
    <string name="bouncer_use_both">Les deux</string>
    <string name="bouncer_use_both_desc">WiM s\'adapte automatiquement. Professionnel pour les apps de travail, décontracté ailleurs.</string>
    <string name="bouncer_next_meet_bubble">suivant : découvrez la bulle</string>
    <string name="bouncer_meet_bubble">Découvrez la bulle</string>
    <string name="bouncer_bubble_intro">Le bouton flottant vit au-dessus de chaque app. C\'est votre assistant vocal — toujours à un toucher de distance.</string>
    <string name="bouncer_gesture_tap">Touchez</string>
    <string name="bouncer_gesture_tap_action">enregistrer / arrêter</string>
    <string name="bouncer_gesture_hold">Maintenez</string>
    <string name="bouncer_gesture_hold_action">enregistre tant que vous maintenez</string>
