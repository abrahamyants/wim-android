    <string name="bouncer_gesture_doubletap_action">menu des réglages</string>
    <string name="bouncer_gesture_drag">Glissez</string>
    <string name="bouncer_gesture_drag_action">déplacez n\'importe où</string>
    <string name="bouncer_gesture_fling">Lancez vers le bas</string>
    <string name="bouncer_gesture_fling_action">fermer</string>
    <string name="bouncer_gesture_shake">Secouez 2x</string>
    <string name="bouncer_gesture_shake_action">la ramener</string>
    <string name="bouncer_recon_title">Ce que vous dites vs. ce qui arrive</string>
    <string name="bouncer_recon_you_say">Vous dites :</string>
    <string name="bouncer_recon_arrives">Ce qui arrive :</string>
    <string name="bouncer_recon_before">euh ouais bah tu peux genre m\'envoyer le rapport j\'en ai besoin pour euh la réunion de demain je crois</string>
    <string name="bouncer_recon_after">Pourriez-vous m\'envoyer le rapport ? J\'en ai besoin pour la réunion de demain.</string>
    <string name="bouncer_recon_caption">Dysfluences reconstruites. Ton appliqué. Le texte arrive dans l\'app où vous tapez.</string>
    <string name="bouncer_send_title">Envoyez directement depuis la bulle</string>
    <string name="bouncer_send_body">Quand votre texte arrive, la bulle devient verte pendant 5 secondes. Touchez pour envoyer. Attendez ou touchez à l\'extérieur pour annuler.\n\nWiM n\'envoie jamais sans ce toucher séparé. Le texte passe par l\'app ouverte — Messages, Gmail, WhatsApp, etc. — en utilisant votre session existante.</string>
    <string name="bouncer_send_ack">Compris. Toucher la bulle verte envoie mon texte.</string>
    <string name="bouncer_next">Suivant</string>
    <string name="bouncer_all_set">Tout est prêt.</string>
    <string name="bouncer_ready_body">WiM est prêt.\n\nLa bulle flottante apparaîtra sur votre écran. Ouvrez n\'importe quelle app, touchez la bulle, et parlez.</string>
    <string name="bouncer_launch_app">Lancer l\'app</string>

