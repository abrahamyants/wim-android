    <string name="bouncer_free">Grátis</string>
    <string name="bouncer_free_desc">Transcrição no dispositivo. Limpa enchimentos e disfluências. Sempre grátis, funciona offline.</string>
    <string name="bouncer_upgrade">Premium</string>
    <string name="bouncer_upgrade_desc">A reconstrução por IA reescreve sua fala com o tom certo. Aprende seu vocabulário. Suporte completo a disfluências.</string>
    <string name="bouncer_use_most">Como você vai usar mais o WiM?</string>
    <string name="bouncer_use_work">Trabalho</string>
    <string name="bouncer_use_work_desc">Tom profissional. Clareza de negócios. E-mails, Slack, reuniões.</string>
    <string name="bouncer_use_personal">Pessoal</string>
    <string name="bouncer_use_personal_desc">Tom casual. Ritmo natural. Mensagens, redes sociais, dia a dia.</string>
    <string name="bouncer_use_both">Ambos</string>
    <string name="bouncer_use_both_desc">O WiM se adapta automaticamente. Profissional para apps de trabalho, casual no resto.</string>
    <string name="bouncer_next_meet_bubble">próximo: conheça a bolha</string>
    <string name="bouncer_meet_bubble">Conheça a bolha</string>
    <string name="bouncer_bubble_intro">O botão flutuante vive sobre qualquer app. É seu assistente de voz — sempre a um toque de distância.</string>
    <string name="bouncer_gesture_tap">Toque</string>
    <string name="bouncer_gesture_tap_action">gravar / parar</string>
    <string name="bouncer_gesture_hold">Segurar</string>
    <string name="bouncer_gesture_hold_action">grava enquanto segura</string>
    <string name="bouncer_gesture_doubletap">Toque duplo</string>
    <string name="bouncer_gesture_doubletap_action">menu de configurações</string>
    <string name="bouncer_gesture_drag">Arraste</string>
    <string name="bouncer_gesture_drag_action">mova para qualquer lugar</string>
    <string name="bouncer_gesture_fling">Lance para baixo</string>
    <string name="bouncer_gesture_fling_action">descartar</string>
    <string name="bouncer_gesture_shake">Sacuda 2x</string>
    <string name="bouncer_gesture_shake_action">trazer de volta</string>
    <string name="bouncer_recon_title">O que você diz vs. o que chega</string>
    <string name="bouncer_recon_you_say">Você diz:</string>
    <string name="bouncer_recon_arrives">O que chega:</string>
    <string name="bouncer_recon_before">é tipo é você poderia me mandar o relatório eu preciso pra reunião de amanhã eu acho</string>
    <string name="bouncer_recon_after">Você poderia me mandar o relatório? Preciso para a reunião de amanhã.</string>
    <string name="bouncer_recon_caption">Disfluências reconstruídas. Tom aplicado. O texto chega no app onde você está digitando.</string>
    <string name="bouncer_send_title">Envie direto da bolha</string>
    <string name="bouncer_send_body">Quando seu texto chega, a bolha fica verde por 5 segundos. Toque para enviar. Espere ou toque fora para cancelar.\n\nO WiM nunca envia sem esse toque separado. O texto passa pelo app aberto — Mensagens, Gmail, WhatsApp etc. — usando sua sessão atual.</string>
    <string name="bouncer_send_ack">Entendi. Tocar na bolha verde envia meu texto.</string>
    <string name="bouncer_next">Próximo</string>
    <string name="bouncer_all_set">Tudo pronto.</string>
    <string name="bouncer_ready_body">O WiM está pronto.\n\nA bolha flutuante vai aparecer na sua tela. Abra qualquer app, toque na bolha e fale.</string>
