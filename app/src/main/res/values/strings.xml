    <string name="bouncer_free">Free</string>
    <string name="bouncer_free_desc">On-device transcription. Cleans up fillers and disfluencies. Always free, works offline.</string>
    <string name="bouncer_upgrade">Upgrade</string>
    <string name="bouncer_upgrade_desc">AI reconstruction rewrites your speech with the right tone. Learns your vocabulary. Full speech disfluency support.</string>
    <string name="bouncer_use_most">How will you use WiM most?</string>
    <string name="bouncer_use_work">Work</string>
    <string name="bouncer_use_work_desc">Professional tone. Business clarity. Emails, Slack, meetings.</string>
