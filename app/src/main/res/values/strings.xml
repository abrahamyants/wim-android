    <string name="bouncer_gesture_shake_action">bring it back</string>
    <string name="bouncer_gesture_command">Drag onto selected text</string>
    <string name="bouncer_gesture_command_action">speak to rewrite it</string>
    <string name="bouncer_recon_title">What you say vs. what arrives</string>
    <string name="bouncer_recon_you_say">You say:</string>
    <string name="bouncer_recon_arrives">What arrives:</string>
    <string name="bouncer_recon_before">yeah so um can you like send me the report I need it for uh the meeting tomorrow I think</string>
    <string name="bouncer_recon_after">Could you please send me the report? I need it for tomorrow\'s meeting.</string>
    <string name="bouncer_recon_caption">Speech disfluencies reconstructed. Tone applied. Text lands in whatever app you\'re typing in.</string>
    <string name="bouncer_send_title">Send straight from the bubble</string>
    <string name="bouncer_send_body">After your text lands, the bubble turns green for 3 seconds. Tap it to send. Wait or tap outside to cancel.\n\nWiM never sends without your tap. The text goes through the app you have open — Messages, Gmail, WhatsApp, etc. — using your existing signed-in session.</string>
    <string name="bouncer_send_ack">I understand. Tapping the green bubble sends my text.</string>
    <string name="bouncer_send_ack_cd">Checkbox: I understand that tapping the green bubble sends my text</string>
    <string name="bouncer_next">Next</string>
    <string name="bouncer_all_set">You\'re all set.</string>
    <string name="bouncer_ready_body">WiM is ready to go.\n\nThe floating bubble will appear on your screen. Open any app, tap the bubble, and speak.</string>
