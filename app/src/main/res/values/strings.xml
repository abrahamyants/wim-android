    <!-- ═══ Samsung deep-sleep permission page ═══ -->
    <string name="bouncer_samsung_title">One more Samsung thing</string>
    <string name="bouncer_samsung_body">Samsung has an extra battery control that can silently kill the WiM bubble overnight — even if you already granted battery optimization.\n\nTap below to open Samsung\'s Deep sleeping apps list and remove WiM from it. If WiM is listed there, the bubble won\'t survive past your screen turning off.</string>
    <string name="bouncer_samsung_action">Open Samsung battery settings</string>
    <string name="bouncer_samsung_done">Done — I removed WiM from the list</string>
    <string name="bouncer_samsung_skip">Skip — already done or not needed</string>
    <string name="bouncer_samsung_nav_hint">Background usage limits → Deep sleeping apps → remove WiM</string>

